object PrimeNumberCheck {
  def main(args: Array[String]): Unit = {
    print("Enter a number: ")
    val num = scala.io.StdIn.readInt()

    var isPrime = true

    if (num <= 1) {
      isPrime = false
    } else {
      for (i <- 2 until num) {
        if (num % i == 0) {
          isPrime = false
        }
      }
    }

    if (isPrime)
      println(s"$num is a Prime number")
    else
      println(s"$num is NOT a Prime number")
  }
}

